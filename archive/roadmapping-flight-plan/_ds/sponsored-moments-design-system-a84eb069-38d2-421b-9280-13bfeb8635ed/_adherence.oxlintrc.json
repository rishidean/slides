{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "ui_kits/sizzle-reel/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Manrope|JetBrains Mono))/i]",
        "message": "Font not provided by the design system. Available: Manrope, JetBrains Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|sponsor|title|body|align|key|ref|className|style|children)$/]",
        "message": "<HeroTitle> doesn't accept that prop. Declared props: eyebrow, sponsor, title, body, align."
      },
      {
        "selector": "JSXOpeningElement[name.name='HeroTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<HeroTitle> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Interstitial'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|label|width|height|key|ref|className|style|children)$/]",
        "message": "<Interstitial> doesn't accept that prop. Declared props: kicker, label, width, height."
      },
      {
        "selector": "JSXOpeningElement[name.name='LoungePassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:airline|flight|route|lounge|gate|heroImg|qrText|key|ref|className|style|children)$/]",
        "message": "<LoungePassCard> doesn't accept that prop. Declared props: airline, flight, route, lounge, gate, heroImg, qrText."
      },
      {
        "selector": "JSXOpeningElement[name.name='PassCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|sponsor|title|body|cta|width|children|key|ref|className|style|children)$/]",
        "message": "<PassCard> doesn't accept that prop. Declared props: eyebrow, sponsor, title, body, cta, width, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='PhoneFrame'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|children|screenBg|key|ref|className|style|children)$/]",
        "message": "<PhoneFrame> doesn't accept that prop. Declared props: width, height, children, screenBg."
      },
      {
        "selector": "JSXOpeningElement[name.name='PushNotification'] > JSXAttribute > JSXIdentifier[name!=/^(?:app|sponsor|time|title|body|icon|iconColor|width|theme|key|ref|className|style|children)$/]",
        "message": "<PushNotification> doesn't accept that prop. Declared props: app, sponsor, time, title, body, icon, iconColor, width, theme."
      },
      {
        "selector": "JSXOpeningElement[name.name='PushNotification'] > JSXAttribute[name.name='theme'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<PushNotification> theme must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Waveform'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|animated|key|ref|className|style|children)$/]",
        "message": "<Waveform> doesn't accept that prop. Declared props: width, height, animated."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {
      "HeroTitle": {
        "replaces": []
      },
      "Interstitial": {
        "replaces": []
      },
      "LoungePassCard": {
